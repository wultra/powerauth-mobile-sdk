{
    "path": "/rest/v4/auth/verify",
    "parameters": [
        "activationId",
        "applicationKey",
        "data",
        "authenticationCode",
        "authenticationCodeType",
        "authenticationVersion",
        "forcedAuthenticationVersion"
    ],
    "response": {
        "class": "PATSVerifySignatureResponse",
        "properties": {
            "activationId":         { "class" : "string" },
            "userId":               { "class" : "string" },
            "activationStatus":     { "class" : "string" },
            "remainingAttempts":    { "class" : "int" },
            "authenticationValid":  { "class" : "bool" }
        }
    }
}
